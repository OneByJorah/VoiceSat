# --- Hermes VPS connection ---
HERMES_API_URL=https://<your-hermes-host>/v1/chat/completions
HERMES_API_KEY=<set-value>
HERMES_MODEL=hermes-3-llama-3.1-8b

# --- Hub bind IP (public IP, LAN IP, or 127.0.0.1 for local-only) ---
HUB_BIND_IP=<set-value>

# --- hermes-ears (STT) ---
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- hermes-mouth (TTS) ---
PIPER_VOICE=en_US-lessac-medium

# --- Honcho memory (self-hosted on another VM) ---
HONCHO_URL=http://<your-honcho-host>:8000
HONCHO_API_KEY=<set-value>
HONCHO_WORKSPACE_ID=hermes-satellite
HONCHO_USER_ID=appuser
HONCHO_ASSISTANT_ID=hermes
HONCHO_CONTEXT_TOKENS=<set-value>

# --- satellite (set per-Pi, not on the hub) ---
BRIDGE_URL=http://<your-hub-host>:18000/satellite/utterance
WAKE_MODEL=hey_jarvis
SATELLITE_ID=satellite-livingroom
